[Unit]
Description=KANT Mobile OS Environment server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/KANTPhone
ExecStart=/usr/bin/python3 /home/pi/KANTPhone/server/server.py --host 0.0.0.0 --port 8420
Restart=on-failure
RestartSec=3
User=pi

[Install]
WantedBy=multi-user.target
